{
  "name": "gmail-connector",
  "version": "1.0.0",
  "description": "A simple Gmail API connector that allows fetching emails with just a few lines of code",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:server": "node test-server.js",
    "example:basic": "cd examples && node basic-usage.js",
    "example:advanced": "cd examples && node advanced-usage.js",
    "example:typescript": "cd examples && npx ts-node typescript-usage.ts",
    "lint": "eslint src/**/*.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "gmail",
    "email",
    "api",
    "connector",
    "oauth",
    "google"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "google-auth-library": "^9.2.0",
    "googleapis": "^128.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/gmail-connector.git"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}

# Gmail API Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/

# OAuth 2.0 Client ID
GMAIL_CLIENT_ID=your_client_id_here.apps.googleusercontent.com

# OAuth 2.0 Client Secret
GMAIL_CLIENT_SECRET=your_client_secret_here

# Redirect URI (must match the one configured in Google Cloud Console)
GMAIL_REDIRECT_URI=http://localhost:3000/callback

# Optional: Custom scopes (comma-separated)
# GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.modify